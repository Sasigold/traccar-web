{
  "name": "viper-fleet-web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/assistant": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@mapbox/mapbox-gl-draw": "^1.5.2",
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
    "@material-symbols/svg-600": "^0.48.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/lab": "^9.0.0-beta.10",
    "@mui/material": "^9.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@tmcw/togeojson": "^7.1.3",
    "@turf/circle": "^7.4.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "gcoord": "^1.0.7",
    "hls.js": "^1.7.4",
    "maplibre-gl": "^6.16.0",
    "maplibre-google-maps": "^1.1.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-country-flag": "3.1.0",
    "react-dom": "^19.3.1",
    "react-qr-code": "^2.2.0",
    "react-redux": "^9.3.1",
    "react-rnd": "^10.5.3",
    "react-router-dom": "^7.18.5",
    "react-window": "^2.5.2",
    "recharts": "^3.10.1",
    "stylis": "^4.4.0",
    "stylis-plugin-rtl": "^2.1.1",
    "tss-react": "^4.9.21",
    "web-vitals": "^5.3.0",
    "wellknown": "^0.5.0",
    "workbox-window": "^7.4.1"
  },
  "scripts": {
    "start": "vite --host",
    "demo": "vite --config demo/vite.config.js",
    "demo:il": "vite --config demo/vite.config.js --mode il",
    "demo:build": "vite build --config demo/vite.config.js --mode demo --outDir build-demo",
    "demo:preview": "vite preview --config demo/vite.config.js --mode demo --outDir build-demo",
    "site": "vite --config website/vite.config.js",
    "site:build": "vite build --config website/vite.config.js",
    "site:preview": "vite preview --config website/vite.config.js",
    "build": "vite build",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal public/logo.svg",
    "lint": "eslint --max-warnings 0 . && node tools/brand-css-guard.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "size": "node tools/size-budget.mjs build",
    "lint:fix": "eslint --fix --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "browserslist": {
    "production": [
      "defaults"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.13",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0",
    "ws": "^8.22.0"
  },
  "overrides": {
    "immer": "11.1.3"
  },
  "allowScripts": {
    "@swc/core@1.16.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
