# Copy to .env.development.local for `npm start` (git ignores *.local files).
# FND-04: nothing points at production by default. Use the staging fleet database here, never
# production. Without these the app runs with the fleet features off.
VITE_FLEET_URL=https://fleet-staging.example.com
VITE_FLEET_ANON_KEY=the-staging-anon-key

# Builds take the same two variables (CI sets them; see .github/workflows/deploy.yml):
#   npm run build                    production; needs VITE_FLEET_URL and VITE_FLEET_ANON_KEY
#   npm run build -- --mode staging  staging; refuses the production database
# VITE_FLEET_URL= (empty) builds without the fleet database on purpose.
