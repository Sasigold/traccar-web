{
  // ARC-11: type checking of the JavaScript logic (npm run typecheck, also in CI). The app is
  // built by Vite, never by tsc. Every .js file is checked; the ones that do not pass yet start with `// @ts-nocheck` (remove it when fixing one). New code may be .ts.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["src/**/__tests__/**", "src/test/**"]
}
